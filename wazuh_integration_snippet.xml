<!-- 
  =============================================================
  รายละเอียดไฟล์ (File Description):
  ไฟล์นี้คือ "ชิ้นส่วนโค้ด (Snippet)" ที่ใช้สำหรับตั้งค่าให้ Wazuh Manager
  สามารถส่งข้อมูลแจ้งเตือน (Alert) ออกไปหาระบบ n8n เพื่อเข้าสู่กระบวนการ AI-SOAR ได้

  คำแนะนำการใช้งาน:
  ห้ามนำไฟล์นี้ไปวางทับไฟล์ ossec.conf เดิมของคุณทั้งไฟล์เด็ดขาด!
  ให้คัดลอกเฉพาะแท็ก <integration> ด้านล่างนี้ ไปแปะแทรกไว้
  ในไฟล์ /var/ossec/etc/ossec.conf ของเครื่อง Wazuh Manager 
  (แนะนำให้วางไว้เหนือแท็ก </ossec_config> บรรทัดสุดท้ายสุด)
  =============================================================
-->

  <!-- เริ่มต้น: การตั้งค่าส่ง Alert ไปยัง n8n (AI-SOAR) -->
  <integration>
    <name>custom-n8n</name>
    <!-- อย่าลืมเปลี่ยน [IP_ของเครื่อง_n8n] เป็นหมายเลข IP จริงของเครื่องที่คุณรัน Docker n8n -->
    <hook_url>http://[IP_ของเครื่อง_n8n]:5678/webhook/wazuh-webhook</hook_url>
    
    <!-- ส่งเฉพาะ Alert ที่มีความรุนแรงตั้งแต่ Level 7 ขึ้นไป (ปรับได้ตามต้องการ) -->
    <level>7</level>
    
    <!-- รูปแบบข้อมูลต้องเป็น JSON เพื่อให้ n8n นำไปใช้ต่อได้ง่าย -->
    <alert_format>json</alert_format>
  </integration>
  <!-- สิ้นสุด: การตั้งค่า n8n -->


  <!-- 
  [ตัวเลือกเสริม] หากคุณไม่อยากกรองด้วย Level แต่อยากกรองด้วย Rule ID ชัดๆ 
  ให้ใช้รูปแบบด้านล่างนี้แทนครับ (ลบเครื่องหมาย Comment ออก)
  -->
  <!--
  <integration>
    <name>custom-n8n</name>
    <hook_url>http://[IP_ของเครื่อง_n8n]:5678/webhook/wazuh-webhook</hook_url>
    <rule_id>5710,5711,5712,100001</rule_id>
    <alert_format>json</alert_format>
  </integration>
  -->
